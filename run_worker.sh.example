#!/bin/bash
# Start background worker
#
# IMPORTANTE: Copiar este archivo como run_worker.sh y completar las variables
# cp run_worker.sh.example run_worker.sh

export PATH="$HOME/.local/bin:$PATH"

# REQUIRED: Tu API key de Google Gemini (obtener en https://aistudio.google.com/app/apikey)
export GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# OPTIONAL: Token de Lichess para rate limits más altos (crear en https://lichess.org/account/oauth/token)
export LICHESS_API_TOKEN="YOUR_LICHESS_TOKEN_HERE"

# REQUIRED: Path a Stockfish engine
# Mac (Homebrew): /opt/homebrew/bin/stockfish
# Linux: /usr/bin/stockfish
# Windows: C:/Program Files/stockfish/stockfish.exe
export STOCKFISH_PATH="/opt/homebrew/bin/stockfish"

# Redis connection
export REDIS_HOST=localhost
export REDIS_PORT=6379

# Phoenix observability
export PHOENIX_ENABLED=true
export PHOENIX_ENDPOINT=http://localhost:6006

echo "Starting Chess Tactics Worker..."
echo "Polling queue: job_queue"
echo "Press Ctrl+C to stop"
echo ""

uv run python -m chess_tactics_orchestrator.worker
