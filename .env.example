# Gemini API key for LLM (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Lichess username to analyze
TEST_LICHESS_USERNAME=your_lichess_username

# Stockfish path (if not in system PATH)
# For Mac with Homebrew: /opt/homebrew/bin/stockfish
# For Linux: /usr/bin/stockfish
# Windows: C:/path/to/stockfish.exe
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Optional: Lichess API token for higher rate limits
# Get from: https://lichess.org/account/oauth/token/create
LICHESS_API_TOKEN=your_lichess_token_here
